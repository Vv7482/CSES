#include<bits/stdc++.h>
using namespace std;
#define int long long 

int n;
vector<int> sub_sz , centroids;
vector<vector<int>> edges;

void dfs(int u , int p){
    sub_sz[u] = 1;
    bool is_centroid = true;

    for(auto v:edges[u]){
        if(v != p){
            dfs(v,u);
            sub_sz[u] += sub_sz[v];

            if(sub_sz[v] > n/2) is_centroid = false;
        }
    }

    if((n-sub_sz[u]) > n/2) is_centroid = false;

    if(is_centroid) centroids.push_back(u);

    return;
}

void solve(){
    cin>>n;
    edges.resize(n+1);
    sub_sz.resize(n+1);

    int a,b;
    for(int i=0 ; i<n-1 ; i++){
        cin>>a>>b;
        edges[a].push_back(b);
        edges[b].push_back(a);
    }

    dfs(1,0);
    sort(centroids.begin() , centroids.end());

    cout<<centroids[0]<<'\n';

    return ;
}

signed main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);

    solve();

    return 0;
}
