#include <bits/stdc++.h>
using namespace std;
#define int long long
 
int n;
vector<int> sub_sz;
vector<vector<int>> edges;
 
void dfs(int nn , int p){
	sub_sz[nn] = 1;
 
	for(auto v:edges[nn]){
		if(v != p){
			dfs(v,nn);
			sub_sz[nn] += sub_sz[v];
		}
	}
 
	return;
}
 
void solve() {
    cin>>n;
	edges.resize(n+1);
	sub_sz.resize(n+1);
 
	int b;
	for(int a=2 ; a<=n ; a++){
		cin>>b;
		edges[a].push_back(b);
		edges[b].push_back(a);
	}
 
	dfs(1,0);
 
	for(int i=1 ; i<=n ; i++) cout<<sub_sz[i]-1<<" ";
	cout<<'\n';
 
	return;
}
                                          
signed main() {
    	ios_base::sync_with_stdio(0);
    	cin.tie(0);
    	cout.tie(0);
    	
		solve();
 
		return 0;
}
