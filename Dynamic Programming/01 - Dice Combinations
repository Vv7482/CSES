#include<bits/stdc++.h>
using namespace std;
#define int long long
const int MOD = 1e9+7;
 
int DP(int n , vector<int> &dp){
	if(n<=1){return 1;}
 
	if(dp[n] != -1){return dp[n];}
 
	dp[n] = 0;
	for(int i = 1; i <= 6; i++) {
	    if(n - i >= 0)
	        dp[n] = (dp[n] + DP(n - i, dp)) % MOD;
	}
 
	return dp[n];
}
 
int main(){
	int n;
	cin>>n;
	vector<int> dp(n+1,-1);
 
	cout<< DP(n,dp)%MOD << endl;
 
	return 0;
}
