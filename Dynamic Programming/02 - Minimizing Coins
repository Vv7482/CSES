#include <bits/stdc++.h>
using namespace std;
#define int long long
const int MOD = 1e9+7;

int n , x ;
int arr[101];
int dp[1000001];

int rec(int i){
    if(i==0) return 0;
    if(dp[i] != -1) return dp[i];
    int ans=INT_MAX;
    for(int j=0 ; j<n ; j++){
        if(arr[j] <= i) ans = min(ans , 1+rec(i-arr[j]));
    }
    return dp[i] = ans;
}

void solve() {
    cin>>n>>x;
    for(int i=0 ; i<n ; i++) cin>>arr[i];
    for(int i=0 ; i<=x ; i++) dp[i] = -1;
    
    int ans = rec(x);
    if(ans == INT_MAX) cout<<"-1\n";
    else cout<<ans<<'\n';
	
    return;
}
                                          
signed main() {
    	ios_base::sync_with_stdio(0);
    	cin.tie(0);
    	cout.tie(0);
    	
		solve();
		return 0;
}
